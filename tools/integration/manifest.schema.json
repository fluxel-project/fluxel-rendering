{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fluxel Rendering integration evidence manifest",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "artifact",
    "rendering_checkout",
    "sibling_checkout_inventory",
    "root_lock",
    "attempts",
    "capability_snapshot",
    "outputs",
    "tests",
    "measurements",
    "unsupported_or_untested",
    "known_limitations"
  ],
  "properties": {
    "schema_version": {
      "enum": [2, 3, 4, 5, 6]
    },
    "stage": {
      "enum": ["S0/S1", "S0-S3 integration evidence", "S5 Forward integration evidence", "S6 typed Forward integration evidence", "S7 Deferred integration evidence"]
    },
    "artifact": {
      "type": "object",
      "required": [
        "owner",
        "path",
        "independent"
      ]
    },
    "rendering_checkout": {
      "$ref": "#/$defs/checkout"
    },
    "sibling_checkout_inventory": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/checkout"
      }
    },
    "root_lock": {
      "$ref": "#/$defs/file_hash"
    },
    "support_decision": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "review"
      ]
    },
    "historical_foundation_support_decision": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "status",
        "scope",
        "cannot_approve_current_support"
      ],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": ["string", "null"] },
        "status": { "const": "historical_reference_only" },
        "scope": { "const": "S0/S1" },
        "cannot_approve_current_support": { "const": true }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "capability_snapshot": {
      "$ref": "#/$defs/evidence"
    },
    "outputs": {
      "$ref": "#/$defs/evidence"
    },
    "tests": {
      "$ref": "#/$defs/evidence"
    },
    "measurements": {
      "$ref": "#/$defs/evidence"
    },
    "unsupported_or_untested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 2 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["support_decision"],
        "properties": { "stage": { "const": "S0/S1" } }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": 6 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["historical_foundation_support_decision"],
        "properties": {
          "stage": { "const": "S7 Deferred integration evidence" },
          "attempts": {
            "items": { "$ref": "#/$defs/s7_attempt" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": 3 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["historical_foundation_support_decision"],
        "properties": { "stage": { "const": "S0-S3 integration evidence" } }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": 4 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["historical_foundation_support_decision"],
        "properties": {
          "stage": { "const": "S5 Forward integration evidence" },
          "attempts": {
            "items": { "$ref": "#/$defs/s5_attempt" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": 5 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["historical_foundation_support_decision"],
        "properties": {
          "stage": { "const": "S6 typed Forward integration evidence" },
          "attempts": {
            "items": { "$ref": "#/$defs/s6_attempt" }
          }
        }
      }
    }
  ],
  "$defs": {
    "checkout": {
      "type": "object",
      "required": [
        "path",
        "revision",
        "dirty",
        "role"
      ]
    },
    "file_hash": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ]
    },
    "source_consistency": {
      "type": "object",
      "required": [
        "status",
        "changed_inputs"
      ],
      "properties": {
        "status": {
          "enum": [
            "stable",
            "changed"
          ]
        },
        "changed_inputs": {
          "type": "array"
        }
      }
    },
    "attempt": {
      "type": "object",
      "required": [
        "id",
        "timestamp_utc",
        "backend",
        "mode",
        "feature",
        "timeout_seconds",
        "directory",
        "toolchain",
        "environment",
        "validation",
        "locks",
        "resolved_git_packages",
        "commands"
      ],
      "properties": {
        "backend": {
          "enum": [
            "dx12",
            "native-gl-wgl"
          ]
        },
        "mode": {
          "enum": [
            "build",
            "run"
          ]
        },
        "commands": {
          "type": "array",
          "minItems": 1
        },
        "runner_exit_status": {
          "type": "integer"
        },
        "source_consistency_after_build": {
          "$ref": "#/$defs/source_consistency"
        },
        "source_consistency_after_attempt": {
          "$ref": "#/$defs/source_consistency"
        },
        "built_fluxel_packages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "package_id",
              "manifest_path",
              "features",
              "target"
            ]
          }
        },
        "built_source_verification": {
          "type": "object",
          "required": [
            "status",
            "mismatches",
            "missing_required_packages"
          ],
          "properties": {
            "status": {
              "enum": [
                "verified",
                "mismatch"
              ]
            }
          }
        },
        "executable": {
          "$ref": "#/$defs/file_hash"
        },
        "source_snapshot": {
          "$ref": "#/$defs/source_snapshot"
        },
        "retained_attempt_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "s5_attempt": {
      "allOf": [
        { "$ref": "#/$defs/attempt" },
        {
          "required": ["workload"],
          "properties": {
            "workload": {
              "type": "object",
              "required": ["selection", "entry_argument", "required_nested_workload", "required_raw_artifacts"],
              "properties": {
                "required_raw_artifacts": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "selection": { "const": "s5-scene-forward-four-layouts" },
                    "entry_argument": { "const": "--s5-only" },
                    "required_nested_workload": { "const": "s5-forward/s5-forward-workload.json" }
                  }
                },
                {
                  "properties": {
                    "selection": { "const": "s5-forward-two-device-cache-isolation" },
                    "entry_argument": { "const": "--s5-device-only" },
                    "required_nested_workload": { "const": "s5-forward-device-isolation/s5-device-isolation-workload.json" }
                  }
                },
                {
                  "properties": {
                    "selection": { "const": "s5-forward-surface-resize" },
                    "entry_argument": { "const": "--s5-surface-only" },
                    "required_nested_workload": { "const": "s5-forward-surface/s5-forward-surface-workload.json" }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "s6_attempt": {
      "allOf": [
        { "$ref": "#/$defs/attempt" },
        {
          "required": ["workload"],
          "properties": {
            "workload": {
              "type": "object",
              "required": ["selection", "entry_argument", "required_nested_workload", "expected_cases", "manifest_contract"],
              "properties": {
                "expected_cases": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "manifest_contract": {
                  "const": "schemaVersion=1; exact named cases; every raw artifact enumerated by one case"
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "selection": { "const": "s6-composed-offscreen-typed-quad" },
                    "entry_argument": { "const": "--s6-only" },
                    "required_nested_workload": { "const": "s6-composed/s6-composed-workload.json" },
                    "expected_cases": {
                      "const": ["original-three-frame-cache", "enabled-disabled-enabled", "independent-providers", "three-pending-replacements"]
                    }
                  }
                },
                {
                  "properties": {
                    "selection": { "const": "s6-composed-surface-resize" },
                    "entry_argument": { "const": "--s6-surface-only" },
                    "required_nested_workload": { "const": "s6-surface/s6-surface-workload.json" },
                    "expected_cases": {
                      "const": ["mesh-after-quad-initial", "quad-after-mesh-resized"]
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "s7_attempt": {
      "allOf": [
        { "$ref": "#/$defs/attempt" },
        {
          "required": ["workload", "source_inputs", "source_snapshot", "retained_attempt_files"],
          "properties": {
            "workload": {
              "type": "object",
              "required": ["selection", "entry_argument", "directory", "required_nested_workload", "expected_cases", "subworkloads", "manifest_contract"],
              "properties": {
                "expected_cases": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "subworkloads": { "type": "array", "items": { "type": "string" } },
                "manifest_contract": {
                  "const": "schemaVersion=1; exact named cases; every raw artifact is listed exactly once by sharedArtifacts, a case, or a declared subworkload manifest"
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "selection": { "const": "s7-deferred-native-offscreen-probe" },
                    "entry_argument": { "const": "--s7-deferred-only" },
                    "directory": { "const": "s7-deferred" },
                    "required_nested_workload": { "const": "s7-deferred/s7-deferred-workload.json" }
                  }
                },
                {
                  "properties": {
                    "selection": { "const": "s7-deferred-color-surface-resize" },
                    "entry_argument": { "const": "--s7-deferred-surface-only" },
                    "directory": { "const": "s7-deferred-surface" },
                    "required_nested_workload": { "const": "s7-deferred-surface/s7-deferred-surface-workload.json" }
                  }
                },
                {
                  "properties": {
                    "selection": { "const": "s7-deferred-device-isolation" },
                    "entry_argument": { "const": "--s7-device-isolation-only" },
                    "directory": { "const": "s7-deferred-device-isolation" },
                    "required_nested_workload": { "const": "s7-deferred-device-isolation/s7-deferred-device-isolation-workload.json" }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "source_snapshot": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "files",
            "kind"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "files": {
              "type": "integer",
              "minimum": 1
            },
            "kind": {
              "const": "exact_worktree_inputs"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "failed"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
